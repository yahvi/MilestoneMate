# MilestoneMate Backend Environment Variables (Render Production Template)
PORT=10000
NODE_ENV=production

# MongoDB Atlas URI (optional - runs in resilient In-Memory Store if not provided)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/milestonemate?retryWrites=true&w=majority

# JWT Authentication Secret (random 32+ character string)
JWT_SECRET=milestonemate_production_jwt_secret_secure_2026

# Google Gemini AI API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# PayPal Developer Sandbox REST Credentials (Get at https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Frontend URL (Your Vercel deployment URL)
CLIENT_URL=https://milestonemate.vercel.app
